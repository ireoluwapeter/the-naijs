  Naijs.randomChoice = function (array) {
    if (!array || array.length === 0) {
      return "";
    }

    return array[Math.floor(Math.random() * array.length)];
  };

  Naijs.getName = function (gender, ethnicity) {
    var group = namePools[ethnicity];

    if (!group) {
      return "";
    }

    var names = group[gender];

    if (!names || names.length === 0) {
      return "";
    }

    return Naijs.randomChoice(names);
  };

  Naijs.generateBirth = function () {
    var ethnicities = Object.keys(namePools);

    var genders = ["female", "male"];

    var gender = Naijs.randomChoice(genders);
    var ethnicity = Naijs.randomChoice(ethnicities);

    var babyName = Naijs.getName(gender, ethnicity);

    var motherName = Naijs.getName("female", ethnicity);
    var fatherName = Naijs.getName("male", ethnicity);

    return {
      gender: gender,
      ethnicity: ethnicity,
      name: babyName,
      mother: motherName,
      father: fatherName
    };
  };

