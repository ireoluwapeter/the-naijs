      male: ["Akpan", "Aniekan", "Edet", "Ekong", "Etim", "Udo"]
    },

    Efik: {
      female: ["Adiaha", "Akpanwan", "Atim", "Ekaette", "Eme", "Uduak"],
      male: ["Asuquo", "Effiong", "Etim", "Idongesit", "Nyong", "Udo"]
    },

    Ijaw: {
      female: ["Benita", "Ebiere", "Ebitare", "Ibitamino", "Preye", "Tamuno"],
      male: ["Abiye", "Brama", "Diri", "Ebi", "Preye", "Tamuno"]
    },

    Urhobo: {
      female: ["Ejiro", "Ese", "Oghenetega", "Onoriode", "Ovie", "Ufuoma"],
      male: ["Ejiro", "Efe", "Oghenekaro", "Oghenerukevwe", "Ovie", "Ufuoma"]
    },

    Tiv: {
      female: ["Aondona", "Dooshima", "Iorliam", "Mnger", "Terseer", "Yange"],
      male: ["Aondofa", "Iorliam", "Mngu", "Terseer", "Torbunde", "Yange"]
    },

    Nupe: {
      female: ["Aisha", "Fatima", "Hauwa", "Maryam", "Rukayya", "Zainab"],
      male: ["Abubakar", "Bello", "Ibrahim", "Musa", "Sani", "Usman"]
    }
  };

  Naijs.randomChoice = function (list) {
    return list[Math.floor(Math.random() * list.length)];
  };

  Naijs.getName = function (gender, ethnicity) {
    var group = names[ethnicity];

    if (!group) {
      group = names.Yoruba;
    }

    var pool = gender === "female" ? group.female : group.male;

    return Naijs.randomChoice(pool);
  };

  Naijs.generateBirth = function () {
    var ethnicities = Object.keys(names);
    var ethnicity = Naijs.randomChoice(ethnicities);
    var gender = Math.random() < 0.5 ? "female" : "male";

    return {
      gender: gender,
      ethnicity: ethnicity,
      name: Naijs.getName(gender, ethnicity),
      mother: Naijs.getName("female", ethnicity),
      father: Naijs.getName("male", ethnicity)
    };
  };
})();