      male: ["Chinedu", "Chukwudi", "Emeka", "Ikenna", "Obinna", "Uche"]
    },

    Hausa: {
      female: ["Aisha", "Amina", "Fatima", "Hauwa", "Hadiza", "Zainab"],
      male: ["Abdullahi", "Ahmad", "Bashir", "Ibrahim", "Musa", "Sani"]
    },

    Edo: {
      female: ["Eseosa", "Osaretin", "Oghosa", "Efe", "Ivie", "Omosefe"],
