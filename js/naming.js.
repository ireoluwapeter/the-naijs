(function () {
  "use strict";

  window.Naijs = window.Naijs || {};

  var names = {
    Yoruba: {
      female: ["Adesewa", "Ayomide", "Damilola", "Eniola", "Folake", "Temilade"],
      male: ["Adekunle", "Adebayo", "Ayomide", "Damilare", "Femi", "Oluwaseun"]
