(function () {
  "use strict";

  window.Naijs = window.Naijs || {};

  Naijs.appearance = {
    skin: "Deep",
    hair: "Afaridan",
    eyes: "Brown",
    ears: "Normal",
    drip: "Hospital Wrap"
  };

  Naijs.initAppearance = function () {
    var finish = document.getElementById("appearance-finish");

    if (finish) {
      finish.addEventListener("click", function () {
        if (typeof Naijs.showBirthResult === "function") {
          Naijs.showBirthResult();
        }
      });
    }
  };

  Naijs.selectAppearance = function (type, value) {
    if (!Naijs.appearance.hasOwnProperty(type)) {
      return;
    }

    Naijs.appearance[type] = value;

    if (type === "hair") {
      var previewHair = document.querySelector(".preview-baby-hair");

      if (previewHair) {
        previewHair.className =
          "preview-baby-hair " +
          value.toLowerCase().replace(/\s+/g, "-");
      }
    }

    var buttons = document.querySelectorAll(
      '[data-appearance="' + type + '"]'
    );

    for (var i = 0; i < buttons.length; i++) {
      if (buttons[i].getAttribute("data-value") === value) {
        buttons[i].classList.add("selected");
      } else {
        buttons[i].classList.remove("selected");
      }
    }
  };
})();