(function () {
  "use strict";

  window.Naijs = window.Naijs || {};

  Naijs.initTitle = function () {
    var startButton = document.getElementById("start-button");

    if (!startButton) {
      return;
    }

    startButton.onclick = function () {
      if (typeof Naijs.startBirth === "function") {
        Naijs.startBirth();
      }
    };
  };

})();