(function () {
  function startGame() {
    var titleScreen = document.getElementById("title-screen");
    var birthScreen = document.getElementById("birth-screen");

    if (!titleScreen || !birthScreen) {
      return;
    }

    titleScreen.classList.add("hidden");
    birthScreen.classList.remove("hidden");

    if (
      window.Naijs &&
      typeof window.Naijs.startBirth === "function"
    ) {
      window.Naijs.startBirth();
    }
  }

  function setupTitle() {
    var startButton = document.getElementById("start-button");

    if (!startButton) {
      return;
    }

    startButton.addEventListener("click", startGame);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTitle);
  } else {
    setupTitle();
  }
})();