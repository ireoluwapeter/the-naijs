(function () {
  "use strict";

  window.Naijs = window.Naijs || {};

  /* ================================
     SCREEN CONTROL
  ================================= */

  Naijs.showScreen = function (screenId) {
    var screens = document.querySelectorAll(".screen");

    for (var i = 0; i < screens.length; i++) {
      screens[i].classList.add("hidden");
    }

    var target = document.getElementById(screenId);

    if (target) {
      target.classList.remove("hidden");
    }
  };


  /* ================================
     HELPERS
  ================================= */

  Naijs.get = function (id) {
    return document.getElementById(id);
  };


  /* ================================
     START GAME
  ================================= */

  Naijs.startGame = function () {

    Naijs.showScreen("birth-screen");

    /*
      Generate the baby immediately.
      This uses the existing naming.js.
    */

    if (typeof Naijs.generateBirth === "function") {
      Naijs.birthState = Naijs.birthState || {};
      Naijs.birthState.baby = Naijs.generateBirth();
    }

    /*
      Start the existing birth cinematic.
    */

    if (typeof Naijs.runBirthSequence === "function") {
      Naijs.runBirthSequence();
    }
  };


  /* ================================
     INITIALISE
  ================================= */

  document.addEventListener("DOMContentLoaded", function () {

    Naijs.showScreen("title-screen");

    var startButton = document.getElementById("start-button");

    if (startButton) {

      startButton.onclick = function () {
        Naijs.startGame();
      };

    }

  });

})();