(function () {
  "use strict";

  window.Naijs = window.Naijs || {};

  Naijs.showScreen = function (screenId) {
    var screens = document.querySelectorAll(".screen");

    for (var i = 0; i < screens.length; i++) {
      screens[i].classList.add("hidden");
    }

    var target = document.getElementById(screenId);

    if (target) {
      target.classList.remove("hidden");
    }
  };

  Naijs.get = function (id) {
    return document.getElementById(id);
  };

  Naijs.on = function (id, eventName, handler) {
    var element = Naijs.get(id);

    if (element) {
      element.addEventListener(eventName, handler);
    }
  };

  document.addEventListener("DOMContentLoaded", function () {
    Naijs.showScreen("title-screen");

    if (typeof Naijs.initTitle === "function") {
      Naijs.initTitle();
    }

    if (typeof Naijs.initBirth === "function") {
      Naijs.initBirth();
    }

    if (typeof Naijs.initAppearance === "function") {
      Naijs.initAppearance();
    }

    if (typeof Naijs.initGame === "function") {
      Naijs.initGame();
    }
  });
})();