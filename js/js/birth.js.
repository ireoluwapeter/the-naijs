(function () {
  "use strict";

  window.Naijs = window.Naijs || {};

  Naijs.birthState = {
    baby: null,
    step: 0,
    timer: null,
    revealTimers: []
  };

  Naijs.startBirth = function () {
    if (typeof Naijs.generateBirth === "function") {
      Naijs.birthState.baby = Naijs.generateBirth();
    }

    Naijs.showScreen("birth-screen");

    var baby = document.querySelector(".newborn-baby");

    if (baby) {
      baby.style.display = "none";
      baby.style.opacity = "0";
      baby.style.visibility = "hidden";
      baby.style.transform = "translateY(45px) scale(0.6)";
      baby.style.transition = "opacity 0.35s ease, transform 0.35s ease";
    }

    Naijs.runBirthSequence();
  };

  Naijs.runBirthSequence = function () {
    var dialogueName = document.getElementById("dialogue-name");
    var dialogueText = document.getElementById("dialogue-text");
    var baby = document.querySelector(".newborn-baby");

    var scenes = [
      {
        name: "Nurse",
        text: "Easy, mama. You dey do well. Take a deep breath."
      },
      {
        name: "Doctor",
        text: "Alright. We are almost there. Keep pushing."
      },
      {
        name: "Father",
        text: "God abeg... everything go dey alright."
      },
      {
        name: "Nurse",
        text: "Yes! Baby is coming!"
      },
      {
        name: "Doctor",
        text: "And... welcome to the world, little one."
      }
    ];

    Naijs.birthState.step = 0;

    function clearRevealTimers() {
      for (var i = 0; i < Naijs.birthState.revealTimers.length; i++) {
        clearTimeout(Naijs.birthState.revealTimers[i]);
      }

      Naijs.birthState.revealTimers = [];
    }

    function revealBaby() {
      if (!baby) {
        return;
      }

      clearRevealTimers();

      baby.style.display = "block";
      baby.style.visibility = "visible";
      baby.style.opacity = "0";
      baby.style.transform = "translateY(45px) scale(0.6)";

      Naijs.birthState.revealTimers.push(
        setTimeout(function () {
          baby.style.opacity = "0.2";
          baby.style.transform = "translateY(36px) scale(0.68)";
        }, 100)
      );

      Naijs.birthState.revealTimers.push(
        setTimeout(function () {
          baby.style.opacity = "0.45";
          baby.style.transform = "translateY(27px) scale(0.76)";
        }, 350)
      );

      Naijs.birthState.revealTimers.push(
        setTimeout(function () {
          baby.style.opacity = "0.7";
          baby.style.transform = "translateY(17px) scale(0.87)";
        }, 650)
      );

      Naijs.birthState.revealTimers.push(
        setTimeout(function () {
          baby.style.opacity = "0.9";
          baby.style.transform = "translateY(7px) scale(0.96)";
        }, 850)
      );

      Naijs.birthState.revealTimers.push(
        setTimeout(function () {
          baby.style.opacity = "1";
          baby.style.transform = "translateY(0) scale(1)";
        }, 1050)
      );
    }

    function nextScene() {
      if (Naijs.birthState.step >= scenes.length) {
        clearInterval(Naijs.birthState.timer);
        clearRevealTimers();

        if (typeof Naijs.showBirthResult === "function") {
          Naijs.showBirthResult();
        }

        return;
      }

      var scene = scenes[Naijs.birthState.step];

      if (dialogueName) {
        dialogueName.textContent = scene.name;
      }

      if (dialogueText) {
        dialogueText.textContent = scene.text;
      }

      if (Naijs.birthState.step === 3) {
        revealBaby();
      }

      Naijs.birthState.step += 1;
    }

    nextScene();

    Naijs.birthState.timer = setInterval(nextScene, 1800);
  };

})();