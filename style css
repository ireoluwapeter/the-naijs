* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  width: 100%;
  min-height: 100%;
  font-family: Arial, Helvetica, sans-serif;
  background: #0b0b0b;
  color: #fff;
}

body {
  overflow: hidden;
}

button {
  font: inherit;
  cursor: pointer;
}

#app {
  width: 100vw;
  height: 100vh;
  min-height: 560px;
  position: relative;
  overflow: hidden;
}

/* =========================
   SHARED SCENE
========================= */

.screen {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.hidden {
  display: none !important;
}

/* =========================
   TITLE SCREEN
========================= */

.title-screen {
  background: #f5d76e;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title-content {
  position: relative;
  z-index: 5;
  text-align: center;
}

.title-heading {
  margin: 0;
  font-size: clamp(3.5rem, 13vw, 8rem);
  font-weight: 900;
  letter-spacing: -0.06em;
  line-height: 0.85;
}

.title-subtitle {
  margin-top: 18px;
  font-size: clamp(0.9rem, 3vw, 1.3rem);
  font-weight: 700;
}

.start-button {
  margin-top: 32px;
  padding: 15px 28px;
  border: 0;
  border-radius: 999px;
  background: #111;
  color: #fff;
  font-weight: 800;
}

/* =========================
   DANFO
========================= */

.danfo {
  position: absolute;
  left: -240px;
  bottom: 12%;
  width: 210px;
  height: 82px;
  z-index: 3;
  animation: danfoDrive 8s linear infinite;
}

.danfo-body {
  position: absolute;
  left: 0;
  bottom: 16px;
  width: 210px;
  height: 58px;
  border-radius: 12px 18px 8px 8px;
  background: #f5c400;
  border: 4px solid #151515;
}

.danfo-front {
  position: absolute;
  right: -3px;
  bottom: 16px;
  width: 42px;
  height: 58px;
  border-radius: 0 17px 7px 0;
  background: #f5c400;
  border: 4px solid #151515;
  border-left: 0;
}

.danfo-window {
  position: absolute;
  top: 8px;
  left: 12px;
  width: 178px;
  height: 27px;
  display: flex;
  gap: 5px;
}

.danfo-window span {
  flex: 1;
  background: #222;
  border: 2px solid #111;
}

.danfo-wheel {
  position: absolute;
  bottom: 0;
  width: 25px;
  height: 25px;
  border-radius: 50%;
  background: #111;
  border: 5px solid #777;
}

.danfo-wheel.left {
  left: 28px;
}

.danfo-wheel.right {
  right: 28px;
}

@keyframes danfoDrive {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(calc(100vw + 500px));
  }
}

/* =========================
   BIRTH SCENE
========================= */

.birth-screen {
  background: #d9d1c5;
}

.hospital-room {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      to bottom,
      #eee8df 0%,
      #eee8df 67%,
      #c9c0b4 67%,
      #c9c0b4 100%
    );
}

.hospital-bed {
  position: absolute;
  left: 14%;
  bottom: 25%;
  width: 48%;
  height: 25%;
}

.bed-frame {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 22%;
  background: #777;
  border-radius: 5px;
}

.bed-mattress {
  position: absolute;
  left: 4%;
  bottom: 21%;
  width: 88%;
  height: 45%;
  background: #f8f8f5;
  border-radius: 12px;
  box-shadow: 0 5px 0 #bbb;
}

.bed-pillow {
  position: absolute;
  left: 8%;
  bottom: 48%;
  width: 24%;
  height: 25%;
  border-radius: 12px;
  background: #fff;
}

.bed-leg {
  position: absolute;
  bottom: -20%;
  width: 5%;
  height: 24%;
  background: #555;
}

.bed-leg.left {
  left: 8%;
}

.bed-leg.right {
  right: 8%;
}

/* =========================
   CHARACTERS
========================= */

.character {
  position: absolute;
  width: 100px;
  height: 190px;
  z-index: 5;
}

.character-head {
  position: absolute;
  top: 0;
  left: 25px;
  width: 50px;
  height: 58px;
  border-radius: 48% 48% 45% 45%;
  background: var(--skin, #6b402b);
  z-index: 3;
}

.character-hair {
  position: absolute;
  top: -7px;
  left: 18px;
  width: 64px;
  height: 28px;
  z-index: 4;
}

.character-body {
  position: absolute;
  top: 58px;
  left: 15px;
  width: 70px;
  height: 90px;
  border-radius: 20px 20px 8px 8px;
  background: var(--clothes, #ffffff);
}

.character-arm {
  position: absolute;
  top: 67px;
  width: 18px;
  height: 70px;
  border-radius: 12px;
  background: var(--skin, #6b402b);
}

.character-arm.left {
  left: 2px;
  transform: rotate(8deg);
}

.character-arm.right {
  right: 2px;
  transform: rotate(-8deg);
}

.character-leg {
  position: absolute;
  top: 140px;
  width: 22px;
  height: 50px;
  border-radius: 8px;
  background: #333;
}

.character-leg.left {
  left: 27px;
}

.character-leg.right {
  right: 27px;
}

/* =========================
   DIALOGUE
========================= */

.dialogue-box {
  position: absolute;
  left: 5%;
  right: 5%;
  bottom: 5%;
  z-index: 20;
  padding: 16px 20px;
  border-radius: 14px;
  background: rgba(15, 15, 15, 0.94);
  border: 2px solid rgba(255, 255, 255, 0.2);
}

.dialogue-name {
  margin-bottom: 5px;
  font-weight: 900;
  font-size: 0.85rem;
  text-transform: uppercase;
}

.dialogue-text {
  font-size: clamp(0.95rem, 3vw, 1.25rem);
  line-height: 1.35;
}

/* =========================
   RESULT SCREEN
========================= */

.result-screen {
  background: #f3e6c8;
  color: #171717;
  padding: 30px;
  overflow-y: auto;
}

.result-card {
  width: min(720px, 94vw);
  margin: 5vh auto;
  padding: 28px;
  border-radius: 24px;
  background: #fff;
  box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
}

.result-card h1 {
  margin-top: 0;
}

/* =========================
   APPEARANCE
========================= */

.appearance-screen {
  background: #efe3cf;
  color: #171717;
  overflow-y: auto;
  padding: 25px;
}

.appearance-container {
  width: min(760px, 94vw);
  margin: 0 auto;
}

.appearance-title {
  font-size: clamp(2rem, 8vw, 4rem);
  font-weight: 900;
  margin: 0;
}

.appearance-subtitle {
  margin-top: 8px;
  font-weight: 700;
}

.appearance-group {
  margin-top: 24px;
}

.appearance-group h3 {
  margin-bottom: 10px;
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.option-button {
  border: 2px solid #222;
  background: #fff;
  color: #111;
  padding: 10px 14px;
  border-radius: 12px;
}

.option-button.selected {
  background: #111;
  color: #fff;
}

.appearance-commentary {
  margin-top: 8px;
  font-style: italic;
  font-weight: 700;
}

.confirm-button {
  margin-top: 28px;
  width: 100%;
  padding: 15px;
  border: 0;
  border-radius: 14px;
  background: #111;
  color: #fff;
  font-weight: 900;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {
  #app {
    min-height: 100svh;
  }

  .hospital-bed {
    left: 8%;
    width: 65%;
  }

  .character {
    transform: scale(0.82);
    transform-origin: bottom center;
  }

  .dialogue-box {
    bottom: 3%;
  }
}